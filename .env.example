ANTHROPIC_API_KEY=sk-ant-...

# Опционально: если хочешь платить через OpenRouter вместо прямого Anthropic-ключа
# (например, оплата картой/криптой через OpenRouter, если Anthropic Billing недоступен)
OPENROUTER_API_KEY=sk-or-...

# Personal Access Token с правами repo (Settings -> Developer settings -> Personal access tokens)
GITHUB_TOKEN=ghp_...
# Репозиторий в формате owner/repo, например maks/devagent
GITHUB_REPO=owner/repo
